# ==============================================================================
# SJ DIGITAL CREATURES - INCUBATOR SERVER ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and populate with local configuration values.
# DO NOT commit '.env' containing production credentials or secrets.
# ==============================================================================

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Engine / Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Portfolio & Workspace Paths
REPOS_ROOT=..

# External SaaS & Counter Sync (Optional)
SAAS_SYNC_INTERVAL_SEC=300
EXTERNAL_METRICS_API_KEY=your_api_key_here
